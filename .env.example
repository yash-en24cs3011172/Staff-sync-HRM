# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string (Atlas or self-hosted).
# When omitted, the HRM System uses its persistent embedded document store automatically.
MONGODB_URI=""

# JWT_SECRET: Secret key used to sign and verify JWT access tokens.
JWT_SECRET="enterprise-hrm-system-jwt-secret-2026"

# PORT: HTTP server port (defaults to 3000)
PORT="3000"
